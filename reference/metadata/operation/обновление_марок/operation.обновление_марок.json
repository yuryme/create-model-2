        "Formula": "//DS | catalog.шифр_км | id ($h.шифр_км) | Select (проект_заказ) | VALUE ( проект_заказ )\n\nasync function getCatalogValue(catalogName, id, fieldName) {\n  var table = await from(catalogName)\n    .select([fieldName])\n    .where('id = @id')\n    .parameter('id', id, 11)\n    .query();\n\n  var value = null;\n\n  if ((table.rows ?? []).length > 0) {\n    value = table.rows[0][fieldName];\n  }\n\n  return value;\n};\nvar result = await getCatalogValue(\n  'catalog.шифр_км',\n  $h.шифр_км,\n  'проект_заказ'\n);",
