/* catalog.марки |  актуальность (1) | шифр_км ($h.шифр_км_подбор) 
| Select (шифр_км as проект, наименование_марки, id as марки, 
title as марки_title, колво as колво_в_кмд, вес_одной_кг as вес_одной_шт_кг, 
вес_всех_кг ) | Compute (колво_т_в_ид, вес_всех_кг / 1000) 
| Compute (колво_шт, колво_в_кмд * 1) |  GetTitle () 
| AddColumn (цена, number, $h.цена_для_подбора  )
| Compute ( сумма, цена * колво_т_в_ид )*/

var result = await from('catalog.марки')
  .select([
    'шифр_км as проект',
    'наименование_марки',
    'id as марки',
    'title as марки_display',
    'колво as колво_в_кмд',
    'вес_одной_кг as вес_одной_шт_кг',
    'вес_всех_кг'
  ])
  .where('актуальность = 1')
  .where('cat_марки.шифр_км = @km')
  .parameter('km', $h.шифр_км_подбор, 11)
  .getDisplays()
  .query();

result = result
  .addColumn('колво_т_в_ид', 'number')
  .addColumn('колво_шт', 'number')
  .addColumn('цена', 'number')
  .addColumn('сумма', 'number')
  .process(r => {
    r.колво_т_в_ид = r.вес_всех_кг / 1000;
    r.колво_шт = r.колво_в_кмд;
    r.цена = $h.цена_для_подбора;
    r.сумма = r.цена * r.колво_т_в_ид;
  });

openPickUp(result, 'table_1');
