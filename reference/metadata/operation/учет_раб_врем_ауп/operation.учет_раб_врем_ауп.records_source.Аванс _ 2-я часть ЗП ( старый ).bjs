//Table.table_2 |  Compute (часы_аванс, д_01 +  д_02+ д_03 + д_04 + д_05 + д_06 +  д_07 + д_08 + д_09 + д_10 + д_11 + д_12 + д_13 + д_14 + д_15 ) 

const table_2 = $t.table_2
  .addColumn({ name: 'часы_аванс',         dataType:'number' });
  .addColumn({ name: 'часы_часть_2_я',     dataType:'number' });
  .addColumn({ name: 'смены_аванс',        dataType:'number' });
  .addColumn({ name: 'смены_часть_2_я',    dataType:'number' });
  .addColumn({ name: 'кту_часы_аванс',     dataType:'number' });
  .addColumn({ name: 'кту_часы_часть_2_я', dataType:'number' });

//| Compute (ф_01, д_01> 0, ф_02, д_02> 0, ф_03, д_03> 0, ф_04, д_04> 0, ф_05, д_05> 0, ф_06, д_06> 0, ф_07, д_07> 0, ф_08, д_08> 0, ф_09, д_09> 0, ф_10, д_10> 0, ф_11, д_11> 0, ф_12, д_12> 0, ф_13, д_13> 0, ф_14, д_14> 0, ф_15, д_15> 0, ф_16, д_16> 0, ф_17, д_17> 0, ф_18, д_18> 0, ф_19, д_19> 0, ф_20, д_20> 0, ф_21, д_21> 0, ф_22, д_22> 0, ф_23, д_23> 0, ф_24, д_24> 0, ф_25, д_25> 0, ф_26, д_26> 0, ф_27, д_27> 0, ф_28, д_28> 0, ф_29, д_29> 0, ф_30, д_30> 0, ф_31, д_31> 0 ) 
//| Compute (смены_аванс, ф_01 + ф_02 + ф_03 + ф_04 + ф_05 + ф_06 + ф_07 + ф_08 + ф_09 + ф_10 + ф_11 + ф_12 + ф_13 + ф_14 + ф_15 ) 
//| Compute (смены_часть_2_я, ф_16 + ф_17 + ф_18 + ф_19 + ф_20 + ф_21 + ф_22 + ф_23 + ф_24 + ф_25 + ф_26 + ф_27 + ф_28 + ф_29 + ф_30 + ф_31 )
  
.process(row => {
  let sum = 0;
  let f_01 = 0;

  for (let i = 1; i <= 15; i++) {
    const field = `д_${i.toString().padStart(2, '0')}`;
    const value = parseNumber(row[field]);
    sum += value;
    if (value > 0) f_01 += 1; // считаем количество дней > 0
  }

  row.часы_аванс = sum;
  row.смены_аванс = f_01;
});
    
  }); // Сумма с 01 по 15

//|  Compute (часы_часть_2_я, д_16 + д_17 + д_18 + д_19 + д_20 + д_21 + д_22 + д_23 + д_24 + д_25 + д_26 + д_27 + д_28 + д_29 + д_30 + д_31 ) 

.process(row => {
  let sum = 0;
  let f_01 = 0;

  for (let i = 16; i <= 31; i++) {
    const field = `д_${i.toString().padStart(2, '0')}`;
    const value = parseNumber(row[field]);
    sum += value;
    if (value > 0) f_01 += 1; // считаем количество дней > 0
  }

    row.часы_часть_2_я = sum;
    row.смены_часть_2_я  = f_01;
    
  }); // Сумма с 16 по 31

//| Compute ( кту_часы_аванс, часы_аванс * кту )
//| Compute ( кту_часы_часть_2_я, часы_часть_2_я * кту )

.process(row => row.кту_часы_аванс = row.часы_аванс * row.кту );
.process(row => row.кту_часы_часть_2_я = row.часы_часть_2_я * row.кту );

return table_2;
