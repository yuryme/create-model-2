//мтс_остатки_от_заяв2 | система_в_рд ($h.система_в_рд ) 
//| GROUPBY ( шифр_рд, система_в_рд, справочник_расценок as номенклатура, едизм, колво as остаток_по_заявке, лист_рд, позиция_в_рд as поз_в_рд ) 
//  | GETTITLE () | HAVING (остаток_по_заявке > 0) | OrderBy (лист_рд, поз_в_рд )
//| Compute ( колво_поставка, остаток_по_заявке * 1 ) | GETTITLE () | AddColumn ( сч, number, 1)

var system_in_rd = $h.система_в_рд;

var tableSaldo = await from('records.мтс_остатки_от_заяв2')
  .select(['шифр_рд', 'система_в_рд', 'справочник_расценок as номенклатура', 'едизм', 'колво as остаток_по_заявке', 'лист_рд', 'позиция_в_рд as поз_в_рд'])
  .where('система_в_рд = @система_в_рд')
  .parameter('система_в_рд', system_in_rd, 11)
  .getDisplays()
  .query();

var tableSaldo = tableSaldo
  .groupBy(
    ['шифр_рд', 'система_в_рд', 'система_в_рд_display','номенклатура', 'номенклатура_display', 'едизм', 'едизм_display', 'лист_рд', 'поз_в_рд'],
    ['остаток_по_заявке']
  )
  .filter(row => (row.остаток_по_заявке ?? 0) > 0)
  .addColumn({ name: 'колво_поставка', dataType: 'number' })
  .process(row =>  row.колво_поставка = (row.остаток_по_заявке ?? 0))
  .addColumn({ name: 'сч', dataType: 'number' })
  .process(row => { row.сч = 1; });
  
openPickUp(tableSaldo, 'table_1');