const days = [];
for (let i = 1; i <= 31; i++) {
  days.push(`д_${String(i).padStart(2, '0')}`);
}

var resultTable = $t.table_2.unpivot('time_str', days)
  .addColumn({name: 'time', dataType: 'number'})
  .process(row=>row.time = parseNumber(row.time_str))
  .filter(row => row.time > 0);

return resultTable;