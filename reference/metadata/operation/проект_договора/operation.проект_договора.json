        "Uid": "f62b72e0-d502-cf3f-8a37-c9c25cc4c3ca",
        "Kind": 0,
        "StandardColumnUid": null,
        "Title": "Представление",
        "Name": "представление",
        "Formula": "function formatDate(date) {\n  if (!date) return '';\n  \n  const d = new Date(date);\n  \n  // Проверка на валидность даты\n  if (isNaN(d.getTime())) return date;\n  \n  const day = String(d.getDate()).padStart(2, '0');\n  const month = String(d.getMonth() + 1).padStart(2, '0');\n  const year = d.getFullYear();\n  \n  return `${day}.${month}.${year}`;\n}\n\nvar result = `Договор #${$h.номер_договора} от ${formatDate($h.дата_договора)} с ${$h.контрагент_наименование}`;\n\nreturn result;",
        "ItemsSource": "",
        "AutoClearMethod": 0,
        "IsStandard": false,
        "DataSettings": {
          "DataTypeUid": "0234c067-7868-46b2-ba8e-e22fae5255cb",
