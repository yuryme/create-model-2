setIsWaiting(true);

var tableFiles = await from('operation.проект_договора.attached_files')
  .where('objectuid = @number')
  .parameter('number', $h.number)
  .query();

var missing = [];

var remarksFileCount = tableFiles
  .clone()
  .filter(row => row.memo?.toLowerCase() === 'мои замечания' 
    && row.username == $h.current_email)
  .count();

if (!remarksFileCount) {
  missing.push('Файл замечаний');
}

if (missing.length) {
  setIsWaiting(false);

  var message = 'Необходимо прикрепить: ' + missing.join(', ');
  alert(message);

  return;
}


var result = await runWorkflow('contract_set_approve', 
                               'set_approve', 
                               [                              
                                {name: 'number', dataType: 'integer', value: $h.number},
                                {name: 'person', dataType: 'integer', value: $h.текущее_физлицо},
                                {name: 'person_fact', dataType: 'integer', value: $h.current_person_const},   
                                {name: 'decision', dataType: 'integer', value: 2}, 
                                {name: 'comment', dataType: 'string', value: $h.approve_comment} 
                               ]);
refresh('list');

$h.approve_comment = '';
$h.статус = 'доработка';
recalculate();
setIsModified(true);
save();

setIsWaiting(false);