        "Formula": " //DS | catalog.договор | id ( $h.договор) | Select () | Value ( контрагент )\n\nasync function getCatalogValue(catalogName, id, fieldName) {\n  var table = await from(catalogName)\n    .select([fieldName])\n    .where('id = @id')\n    .parameter('id', id, 11)\n    .query();\n\n  var value = null;\n\n  if ((table.rows ?? []).length > 0) {\n    value = table.rows[0][fieldName];\n  }\n\n  return value;\n};\nvar result = await getCatalogValue(\n  'catalog.договор',\n  $h.договор,\n  'контрагент'\n);\n\nreturn result;",
