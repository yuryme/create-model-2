var result = await from('catalog.справочник_расценок')
  .select([
    'id as справочник_расценок',
    'шифр_расценки_эсс',
    'наим_сборника_эсс',
    'работа_по_проекту',
    'едизм',
    'цена'
  ])
  .where('проект = @project')
  .parameter('project', $h.проект_заказ, 11)
  .orderBy('шифр_расценки_эсс')
  .query();

openPickUp(result, 'етвв');
