          "Title": "id_операции",
          "Name": "id_операции",
          "Formula": "//DS | operation.марки_статусы | позиция_марок ($r.марки) | Select (id) | Value ( id )\n\nasync var table = await from('operation.марки_статусы')\n  .select(['number'])\n  .where('позиция_марок = @marka')\n  .parameter('marka', r.марки)\n  .query();\n\nvar value = null;\n\nif ((table.rows ?? []).length > 0) {\n  value = table.rows[0].number;\n}\n\nreturn value;\n",
