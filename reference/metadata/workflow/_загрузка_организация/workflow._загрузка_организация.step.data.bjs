// Задаем колонки один раз
var columns = [
  {name: 'id', dataType: 'number'},
  {name: 'uid'},
  {name: 'name'},
  {name: 'title'},
  {name: 'memo'},
  {name: 'isdeleted'},
  {name: 'titletoprint'},
  {name: 'inn'},
  {name: 'kpp'},
  {name: 'okato'},
  {name: 'phone'},
  {name: 'email'},
  {name: 'legaladdress'},
  {name: 'address'},
  {name: 'externalcode'},
  {name: 'externaluid'},
  {name: 'id1'},
  {name: 'id2'}
];

// Создаем таблицу
var table = createTable(columns);

// Функция для маппинга строки
function mapRow(row, columns) {
  let mapped = {};
  columns.forEach(c => {
    mapped[c.name] = row[c.name];
  });
  return mapped;
}

// Загружаем данные в таблицу
_data.request.data.forEach(row => {
  table.addRow(mapRow(row, columns));
});

return table;