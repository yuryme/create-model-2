// Задаем колонки один раз
var columns = [
  {name: 'id', dataType: 'number'},
  {name: 'uid'},
  {name: 'name'},
  {name: 'code'},
  {name: 'title'},
  {name: 'memo'},
  {name: 'isdeleted'},
  {name: 'isfiles'},
  {name: 'externalcode'},
  {name: 'externaluid'},
  {name: 'проект'},
  {name: 'тип_марка_и_пр'},
  {name: 'тип_рд'},
  {name: 'код_изделия'},
  {name: 'завод'},
  {name: 'группа_номенклатуры_в_рд'},
  {name: 'группа_номенклатуры'},
  {name: 'примечание'},
  {name: 'описание_для_составных_нр'},
  {name: 'сокращенное'},
  {name: 'группа_2'}
  
];

// Создаем таблицу
var table = createTable(columns);

// Функция для маппинга строки
function mapRow(row, columns) {
  let mapped = {};
  columns.forEach(c => {
    mapped[c.name] = row[c.name];
  });
  return mapped;
}

// Загружаем данные в таблицу
_data.request.data.forEach(row => {
  table.addRow(mapRow(row, columns));
});

return table;