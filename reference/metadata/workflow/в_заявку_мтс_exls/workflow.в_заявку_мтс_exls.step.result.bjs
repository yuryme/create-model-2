var result_5 = await from("catalog.справочник_расценок")
  .select(['id as номенклатура', 'title as номенклатура_display', 'проект',
          'код_изделия', 'завод', 'описание_для_составных_нр as описание',
           'тип_марка_и_пр as тип'])
  .where("проект = @project")
  .parameter("project", _parameters.project, 11)
  .query();

var result_6 = await from("catalog.ед_изм_2")
  .select(['id as едизм', 'title as едизм_display'])
  .query();

var result_7 = await from("catalog.система_в_рд")
  .select(['id as система_в_рд', 'title as система_в_рд_display', 'шифр_рд '])
  .where("проект = @project")
  .parameter("project", _parameters.project, 11)
  .where("шифр_рд  = @code_rd")
  .parameter("code_rd", _parameters.code_rd, 11)
  .query();

var mapp = _data.mapping;
var result = mapp.leftJoin(result_5, (pr,jn) => pr.items == jn.номенклатура_display)
   .leftJoin(result_6, (pr,jn) => pr.measure == jn.едизм_display)
   .leftJoin(result_7, (pr,jn) => pr.system == jn.система_в_рд_display)
   .addColumn({name: 'сч', dataType: 'number'})
   .process(row => row.сч = 1)
   .process(row => { if (row.номенклатура === 0) row.номенклатура = null; });

return result;