/* TempTable.дан_опер;
TempTable.меппинг;

CreateTable(проект_заказ integer) | UnionAll($result_1) | LIST(проект_заказ);
Catalog.шифр_км | проект_заказ  ($result_3) | Select (id, title as шифр_км_title, 
проект_заказ, цена_монтажа as цена );
CreateTable | FullJoinAuto ($result_4, ) | GroupBy (id) | List ( id);
Catalog.марки | актуальность (1) | шифр_км ($result_5) | Select (id as марки, title, наименование_марки as наименование, шифр_км as проект, уникальное_поле, колво as колво_в_кмд, вес_одной_кг as вес_одной_шт_кг, вес_всех_кг) | GetTitle ();
CreateTable | FullJoinAuto ($result_2, ) | Concatenate (уникальное_поле, шифр_км,_,марка) | LeftJoinAuto ( $result_6, уникальное_поле = result_6.уникальное_поле ) | Having ( title is not Null ) | LeftJoinAuto ( $result_4, шифр_км = result_4.шифр_км_title )  | Compute ( сумма, цена * колво_шт * вес_одной_шт_кг / 1000) | Compute ( колво_т_в_ид,  колво_шт * вес_одной_шт_кг / 1000)*/

var oper = _data.operation_data;
var mapping = _data.mapping;

/* проекты */

var project = oper.rows[].проект_заказ

/* КМ с ценой */

var kmTable = await from('catalog.шифр_км')
  .select(['id', 'title as шифр_км_display', 'проект_заказ', 'цена_монтажа as цена'])
  .where('проект_заказ = @prj')
  .parameter('prj', project, 11)
  .query();

/* марки */

var kmIds = Array.from(
  new Set((kmTable.rows ?? []).map(r => r.id).filter(v => v != null))
);

var marki = await from('catalog.марки')
  .select([
    'id as марки',
    'title as марки_display',
    'наименование_марки as наименование',
    'шифр_км as проект',
    'уникальное_поле',
    'колво as колво_в_кмд',
    'вес_одной_кг as вес_одной_шт_кг',
    'вес_всех_кг'
  ])
  .where('актуальность = 1')
  .where('проект_заказ = @prj AND  шифр_км in @kmIds_')
  .parameter('prj', project, 11)
  .parameter('kmIds_', kmIds, 11)
  .getDisplays()
  .query();

/* сборка */

var result = mapping
  .addColumn('уникальное_поле', 'string')
  .addColumn('сумма', 'number')
  .addColumn('колво_т_в_ид', 'number')
  .process(r => {
    r.уникальное_поле =
      String(r.шифр_км ?? '') +
      '_' +
      String(r.марка ?? '');
  })
  .leftJoin(
    marki,
    (pr, jn) => pr.уникальное_поле === jn.уникальное_поле
  )
  .filter(r => r.марки != 0)
  .leftJoin(
    kmTable,
    (pr, jn) => pr.шифр_км === jn.шифр_км_display
  )
  .process(r => {
    r.колво_т_в_ид =
      parseNumber(r.колво_шт) *
      parseNumber(r.вес_одной_шт_кг) /
      1000;

    r.сумма =
      parseNumber(r.цена) *
      parseNumber(r.колво_шт) *
      parseNumber(r.вес_одной_шт_кг) /
      1000;
  });

return result;
