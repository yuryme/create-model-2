var src = _data.delete_null_rows;

var result = src
  .filter(r =>
    isNotEmpty(r.марка_стали) &&
    ((r.марка_стали_id ?? 0) === 0)     // <-- ключевое: нет найденного id
  )
  .groupBy(['марка_стали'], [])
  .addColumn('марка_стали_справочник number')
  .process(r => { r.марка_стали_справочник = null; });

return result;
