var table = createTable([
  {name: 'id', dataType: 'number'},
  {name: 'uid'},
  {name: 'name'},
  {name: 'title'},
  {name: 'memo'},
  {name: 'полное_имя'},
  {name: 'размер_одежды', dataType: 'number'},
  {name: 'размер_обуви', dataType: 'number'},
  {name: 'email'},
  {name: 'группа'},
  {name: 'вахта'},
  {name: 'телефон'},
  {name: 'табельный_номер_1с'},
  {name: 'вахта_uid'},
  {name: 'group_uid'}
]);

_data.request.data.forEach(row => {
  table.addRow({
    id: row.id,
    uid: row.uid,
    title: row.title,
    memo: row.memo,
    полное_имя: row.полное_имя,
    размер_одежды: row.размер_одежды,
    размер_обуви: row.размер_обуви,
    email: row.email,
    группа: row.группа,
    вахта: row.вахта,
    телефон: row.телефон,
    табельный_номер_1с: row.табельный_номер_1с,
    вахта_uid: row.вахта_uid,
    group_uid: row.group_uid
  });
});

return table;