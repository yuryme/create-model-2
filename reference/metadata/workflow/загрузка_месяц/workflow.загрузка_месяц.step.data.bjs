var table = createTable([
  {name: 'id', dataType: 'number'},
  {name: 'uid'},
  {name: 'name'},
  {name: 'title'},
  {name: 'мес_коротко'},
  {name: 'месяц_строка'},
]);

_data.request.data.forEach(row => {
  table.addRow({
    id: row.id,
    uid: row.uid,
    name: row.name,
    title: row.title,
    мес_коротко: row.мес_коротко,
    месяц_строка: row.месяц_строка,
  });
});

return table;