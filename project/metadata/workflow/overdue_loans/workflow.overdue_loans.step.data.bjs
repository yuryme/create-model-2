// Список просроченных невозвращённых книг одной выдачи (построчно).
// Параметр _parameters.loan_number — значение PK (number) той выдачи,
// по которой строится отчёт. Передаётся клиентской командой
// refresh_overdue_books через runWorkflow.
//
// Контракт: четыре колонки на каждую невозвращённую просроченную книгу
// именно этой выдачи. Группировки нет: одна выданная и невозвращённая
// книга = одна строка результата.
//
// QueryBuilder в текущей сборке BaSYS не выражает JOIN на четыре сущности
// одним запросом, поэтому собираем результат под-запросами и
// постобрабатываем DataTable-хелперами (ТЗ §4.2 разрешает этот путь).
//
// Шаги:
//   1) Шапка нужной выдачи: number=loan_number, не удалена, due_date<today,
//      due_date задан.
//   2) Невозвращённые строки её табличной части books.
//   3) Карточки книг (только не удалённые) из catalog/book — для author и title.
//   4) Авторы из catalog/author — для title (отображаемого имени).
//   5) Цепочка innerJoin: header ⨝ books ⨝ book ⨝ author.
//   6) days_overdue считаем построчно по due_date шапки (одинаков для всех строк).

const loanNumber = _parameters.loan_number;
const today = dateTimeNow();

const headers = await from("operation.loan")
  .where("number = @loanNumber and is_deleted = @notDeleted and due_date is not null and due_date < @today")
  .parameter("loanNumber", loanNumber, 11)
  .parameter("notDeleted", false, 3)
  .parameter("today", today, 6)
  .query();

if (headers.rows.length === 0) {
  return createTable('book_author string, book_title string, due_date date, days_overdue number');
}

const headerRow = headers.rows[0];

const unreturnedBooks = await from("operation.loan.books")
  .where("object_uid = @objectUid and is_returned = @notReturned")
  .parameter("objectUid", headerRow.number, 11)
  .parameter("notReturned", false, 3)
  .query();

if (unreturnedBooks.rows.length === 0) {
  return createTable('book_author string, book_title string, due_date date, days_overdue number');
}

const books = await from("catalog.book")
  .where("is_deleted = @notDeleted")
  .parameter("notDeleted", false, 3)
  .query();

const authors = await from("catalog.author")
  .where("is_deleted = @notDeleted")
  .parameter("notDeleted", false, 3)
  .query();

const booksWithAuthor = books.innerJoin(
  authors,
  (b, a) => b.author == a.id,
  [
    { table: 'primary',   name: 'id' },
    { table: 'primary',   name: 'title', alias: 'book_title' },
    { table: 'secondary', name: 'title', alias: 'book_author' }
  ]
);

const joined = unreturnedBooks.innerJoin(
  booksWithAuthor,
  (row, b) => row.book == b.id,
  [
    { table: 'secondary', name: 'book_author' },
    { table: 'secondary', name: 'book_title' }
  ]
);

const MS_PER_DAY = 24 * 60 * 60 * 1000;
const dueDate = new Date(headerRow.due_date);
const daysOverdue = Math.floor((today.getTime() - dueDate.getTime()) / MS_PER_DAY);

joined.addColumns('due_date date, days_overdue number');
joined.process((row) => {
  row.due_date = headerRow.due_date;
  row.days_overdue = daysOverdue;
});

return joined.orderBy((a, b) => {
  const x = (a.book_title || '').toString();
  const y = (b.book_title || '').toString();
  return x < y ? -1 : x > y ? 1 : 0;
});
