setIsWaiting(true);

var currentObject = $h.number || 0;
var records = await from('records.recognition_minutes')
  .where('company = @company AND NOT (meta_object = @meta_object AND object_uid = @object_uid)')
  .parameter('company', $h.company, 11)
  .parameter('meta_object', '6f92a376-a0ce-4529-b3d2-6f99f4da3270', 9)
  .parameter('object_uid', currentObject, 11)
  .select(['period', 'object_uid', 'counterparty', 'package_purchase', 'minute_price', 'minutes', 'amount', 'is_overrun'])
  .query();

var packages = await from('operation.recognition_package')
  .select(['number', 'date'])
  .query();

var packageDisplayByNumber = {};
for (var p = 0; p < packages.rows.length; p++) {
  var packageItem = packages.rows[p];
  packageDisplayByNumber[String(packageItem.number)] = 'Пакет #' + packageItem.number + ' от ' + packageItem.date;
}

var packagesByClient = {};

for (var i = 0; i < records.rows.length; i++) {
  var row = records.rows[i];
  if (row.is_overrun || !row.package_purchase) {
    continue;
  }

  var clientKey = String(row.counterparty);
  var packageKey = String(row.counterparty) + '|' + String(row.package_purchase) + '|' + String(row.minute_price);

  if (!packagesByClient[clientKey]) {
    packagesByClient[clientKey] = [];
  }

  var packageRow = packagesByClient[clientKey].find(p => p.key === packageKey);
  if (!packageRow) {
    packageRow = {
      key: packageKey,
      period: row.period,
      counterparty: row.counterparty,
      package_purchase: row.package_purchase,
      minute_price: row.minute_price || 0,
      balance: 0
    };
    packagesByClient[clientKey].push(packageRow);
  }

  packageRow.balance += row.minutes || 0;
}

Object.keys(packagesByClient).forEach(clientKey => {
  packagesByClient[clientKey] = packagesByClient[clientKey]
    .filter(p => p.balance > 0)
    .sort((a, b) => new Date(a.period) - new Date(b.period));
});

var result = createTable([
  { name: 'counterparty' },
  { name: 'counterparty_display' },
  { name: 'package_purchase' },
  { name: 'package_purchase_display' },
  { name: 'minute_price' },
  { name: 'minutes' },
  { name: 'amount' },
  { name: 'is_overrun' }
]);

for (var j = 0; j < $t.items.rows.length; j++) {
  var usage = $t.items.rows[j];
  var counterparty = usage.counterparty;
  var counterpartyDisplay = usage.counterparty_display;
  var remaining = usage.minutes || 0;
  var clientPackages = packagesByClient[String(counterparty)] || [];

  for (var k = 0; k < clientPackages.length && remaining > 0; k++) {
    var pack = clientPackages[k];
    var take = Math.min(remaining, pack.balance);
    if (take <= 0) {
      continue;
    }

    result.rows.push({
      counterparty: counterparty,
      counterparty_display: counterpartyDisplay,
      package_purchase: pack.package_purchase,
      package_purchase_display: packageDisplayByNumber[String(pack.package_purchase)] || null,
      minute_price: pack.minute_price,
      minutes: take,
      amount: take * pack.minute_price,
      is_overrun: false
    });

    pack.balance -= take;
    remaining -= take;
  }

  if (remaining > 0) {
    result.rows.push({
      counterparty: counterparty,
      counterparty_display: counterpartyDisplay,
      package_purchase: null,
      package_purchase_display: null,
      minute_price: 2,
      minutes: remaining,
      amount: remaining * 2,
      is_overrun: true
    });
  }
}

$t.write_offs.clear();
$t.write_offs.load(result);
setIsWaiting(false);
setIsModified(true);
